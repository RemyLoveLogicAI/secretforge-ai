#!/bin/bash
# SecretForge CLI

set -euo pipefail
umask 077

VERSION="1.2.0"
VAULT_DIR="$HOME/.secretforge"
CONFIG_FILE="$VAULT_DIR/config.json"
MASTER_KEY_FILE="$VAULT_DIR/.key"
LOG_FILE="$VAULT_DIR/evolution.log"

log_evolution() {
  [ -d "$VAULT_DIR" ] || return 0
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $1" >> "$LOG_FILE"
}

ensure_vault() {
  if [ ! -f "$CONFIG_FILE" ] && [ ! -e "$MASTER_KEY_FILE" ]; then
    mkdir -p "$VAULT_DIR"
    openssl rand -hex 64 > "$MASTER_KEY_FILE"
    touch "$LOG_FILE"
    cat > "$CONFIG_FILE" <<EOF
{
  "version": "$VERSION",
  "created": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "evolution_level": 0,
  "auto_discovery": true,
  "ai_suggestions": true,
  "platforms": {
    "vercel": { "enabled": true, "auto_sync": false },
    "railway": { "enabled": true, "auto_sync": false },
    "cloudflare": { "enabled": true, "auto_sync": false },
    "github": { "enabled": true, "auto_sync": false }
  },
  "secrets": {}
}
EOF
    log_evolution "Vault initialized - Evolution begins"
  elif [ ! -f "$CONFIG_FILE" ] || [ ! -f "$MASTER_KEY_FILE" ]; then
    echo "Vault is incomplete: expected config.json and .key in $VAULT_DIR" >&2
    return 1
  fi
  chmod 700 "$VAULT_DIR"
  chmod 600 "$MASTER_KEY_FILE" "$CONFIG_FILE"
}

store_secret() {
  local KEY="$1" VALUE="$2" SOURCE="${3:-manual}"
  if [ -z "$KEY" ]; then echo "Key required" >&2; return 1; fi
  if [ -z "$VALUE" ]; then echo "Value required" >&2; return 1; fi

  ensure_vault
  if ! ENCRYPTED="$(printf '%s' "$VALUE" | openssl enc -aes-256-cbc -a -salt -pbkdf2 -iter 100000 -pass file:"$MASTER_KEY_FILE" 2>/dev/null | tr -d '\n')"; then
    echo "Encryption failed" >&2
    return 1
  fi
  if [ -z "$ENCRYPTED" ]; then echo "Encryption failed" >&2; return 1; fi

  CONFIG_FILE="$CONFIG_FILE" MASTER_KEY_FILE="$MASTER_KEY_FILE" SECRET_KEY="$KEY" SECRET_SOURCE="$SOURCE" SECRET_VALUE="$ENCRYPTED" python3 <<'PYEOF'
import hashlib, hmac, json, os, tempfile
from datetime import datetime, timezone

cfg = os.environ["CONFIG_FILE"]
with open(os.environ["MASTER_KEY_FILE"], encoding="ascii") as f:
    master_key = bytes.fromhex(f.read().strip())
auth_key = hmac.new(master_key, b"secretforge:record-authentication:v2", hashlib.sha256).digest()
with open(cfg, encoding="utf-8") as f:
    data = json.load(f)
record = {
    "encrypted": True,
    "source": os.environ["SECRET_SOURCE"],
    "updated": datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z'),
    "format_version": 2,
    "value": "secretforge:v2:" + os.environ["SECRET_VALUE"]
}
authenticated = {"key": os.environ["SECRET_KEY"], "record": record}
canonical = json.dumps(authenticated, sort_keys=True, separators=(",", ":")).encode()
record["mac"] = hmac.new(auth_key, canonical, hashlib.sha256).hexdigest()
data.setdefault("secrets", {})[os.environ["SECRET_KEY"]] = record
data["evolution_level"] = data.get("evolution_level", 0) + 1
fd, temp_path = tempfile.mkstemp(dir=os.path.dirname(cfg), prefix=".config.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(temp_path, 0o600)
    os.replace(temp_path, cfg)
except BaseException:
    try:
        os.unlink(temp_path)
    except FileNotFoundError:
        pass
    raise
PYEOF

  log_evolution "Stored: $KEY (source: $SOURCE)"
}

migrate_vault() {
  ensure_vault
  CONFIG_FILE="$CONFIG_FILE" MASTER_KEY_FILE="$MASTER_KEY_FILE" python3 <<'PYEOF'
import hashlib, hmac, json, os, sys, tempfile

config_path = os.environ["CONFIG_FILE"]
with open(os.environ["MASTER_KEY_FILE"], encoding="ascii") as f:
    master_key = bytes.fromhex(f.read().strip())
auth_key = hmac.new(master_key, b"secretforge:record-authentication:v2", hashlib.sha256).digest()

with open(config_path, encoding="utf-8") as f:
    data = json.load(f)
secrets = data.get("secrets")
if not isinstance(secrets, dict):
    print("Invalid vault: secrets must be an object.", file=sys.stderr)
    sys.exit(1)

upgraded = 0
for key, record in secrets.items():
    if not isinstance(key, str) or not isinstance(record, dict):
        print("Invalid vault record; no migration was applied.", file=sys.stderr)
        sys.exit(1)
    value = record.get("value")
    if not isinstance(value, str):
        print(f"Invalid secret value for {key}; no migration was applied.", file=sys.stderr)
        sys.exit(1)
    version = record.get("format_version", 1)
    has_envelope = value.startswith("secretforge:v2:")
    if version == 2 or has_envelope:
        if version != 2 or not has_envelope:
            print(f"Inconsistent authenticated record for {key}; no migration was applied.", file=sys.stderr)
            sys.exit(1)
        authenticated = {"key": key, "record": {name: item for name, item in record.items() if name != "mac"}}
        canonical = json.dumps(authenticated, sort_keys=True, separators=(",", ":")).encode()
        expected = hmac.new(auth_key, canonical, hashlib.sha256).hexdigest()
        provided = record.get("mac")
        if not isinstance(provided, str) or not hmac.compare_digest(expected, provided):
            print(f"Integrity check failed for {key}; no migration was applied.", file=sys.stderr)
            sys.exit(1)
        continue
    if type(version) is not int or version != 1:
        print(f"Unsupported secret format version for {key}; no migration was applied.", file=sys.stderr)
        sys.exit(1)
    record["format_version"] = 2
    record["value"] = "secretforge:v2:" + value
    authenticated = {"key": key, "record": record}
    canonical = json.dumps(authenticated, sort_keys=True, separators=(",", ":")).encode()
    record["mac"] = hmac.new(auth_key, canonical, hashlib.sha256).hexdigest()
    upgraded += 1

if upgraded:
    fd, temp_path = tempfile.mkstemp(dir=os.path.dirname(config_path), prefix=".config.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.chmod(temp_path, 0o600)
        os.replace(temp_path, config_path)
    except BaseException:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass
        raise

print(f"Migrated {upgraded} legacy secret(s).")
PYEOF
  log_evolution "Migrated legacy secrets"
}

read_secret_value() {
  if [ -t 0 ]; then
    printf 'Secret value: ' >&2
    if ! IFS= read -r -s VALUE; then
      printf '\n' >&2
      echo "Unable to read secret value" >&2
      return 1
    fi
    printf '\n' >&2
  elif ! IFS= read -r VALUE && [ -z "${VALUE:-}" ]; then
    echo "No secret value provided on standard input" >&2
    return 1
  fi
  store_secret "$1" "$VALUE" "manual"
}

get_secret() {
  local KEY="$1"
  ensure_vault
  local RECORD
  if ! RECORD="$(CONFIG_FILE="$CONFIG_FILE" MASTER_KEY_FILE="$MASTER_KEY_FILE" SECRET_KEY="$KEY" python3 <<'PYEOF'
import hashlib, hmac, json, os, sys
try:
    with open(os.environ["CONFIG_FILE"], encoding="utf-8") as f:
        data = json.load(f)
    val = data.get("secrets", {}).get(os.environ["SECRET_KEY"])
    if val is None:
        sys.exit(1)
    if not isinstance(val, dict):
        print("Invalid secret record; refusing to return the value.", file=sys.stderr)
        sys.exit(2)
    stored_value = val.get("value", "")
    if not isinstance(stored_value, str):
        print("Invalid secret value; refusing to return it.", file=sys.stderr)
        sys.exit(2)
    version = val.get("format_version", 1)
    if stored_value.startswith("secretforge:v2:"):
        version = 2
    if type(version) is not int:
        print(f"Invalid secret format version: {version}", file=sys.stderr)
        sys.exit(2)
    if version == 2:
        if not stored_value.startswith("secretforge:v2:"):
            print("Invalid authenticated secret envelope.", file=sys.stderr)
            sys.exit(2)
        with open(os.environ["MASTER_KEY_FILE"], encoding="ascii") as f:
            master_key = bytes.fromhex(f.read().strip())
        auth_key = hmac.new(master_key, b"secretforge:record-authentication:v2", hashlib.sha256).digest()
        record = {name: item for name, item in val.items() if name != "mac"}
        authenticated = {"key": os.environ["SECRET_KEY"], "record": record}
        canonical = json.dumps(authenticated, sort_keys=True, separators=(",", ":")).encode()
        expected = hmac.new(auth_key, canonical, hashlib.sha256).hexdigest()
        provided = val.get("mac")
        if not isinstance(provided, str) or not hmac.compare_digest(expected, provided):
            print("Secret integrity check failed; refusing to return the value.", file=sys.stderr)
            sys.exit(2)
    elif version != 1:
        print(f"Unsupported secret format version: {version}", file=sys.stderr)
        sys.exit(2)
    else:
        print("Warning: this legacy secret has no integrity check; re-store it to upgrade.", file=sys.stderr)
    if version == 2:
        stored_value = stored_value[len("secretforge:v2:"):]
    print(json.dumps({"value": stored_value, "encrypted": val.get("encrypted", True)}))
except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError, TypeError):
    sys.exit(1)
PYEOF
  )"; then
    echo "Secret not found or unreadable: $KEY" >&2
    return 1
  fi
  read -r ENCRYPTED ENCRYPTED_FLAG < <(printf '%s' "$RECORD" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["value"], d["encrypted"])')
  if [ -z "${ENCRYPTED:-}" ]; then echo "Secret not found: $KEY" >&2; return 1; fi
  if [ "$ENCRYPTED_FLAG" = "True" ] || [ "$ENCRYPTED_FLAG" = "true" ]; then
    if ! printf '%s\n' "$ENCRYPTED" | openssl enc -aes-256-cbc -d -a -pbkdf2 -iter 100000 -pass file:"$MASTER_KEY_FILE" 2>/dev/null; then
      echo "Unable to decrypt secret: $KEY" >&2
      return 1
    fi
  else
    printf '%s\n' "$ENCRYPTED"
  fi
}

list_secrets() {
  ensure_vault
  CONFIG_FILE="$CONFIG_FILE" python3 <<'PYEOF'
import json, os
with open(os.environ["CONFIG_FILE"], encoding="utf-8") as f:
    cfg = json.load(f)
secrets = cfg.get("secrets", {})
if not secrets:
    print("  No secrets stored yet.")
else:
    print(f"{'Key':<35} {'Source':<20} {'Updated'}")
    print("─"*80)
    for k,v in secrets.items():
        print(f"{k:<35} {v.get('source','unknown'):<20} {v.get('updated','')[:10]}")
    print(f"\nTotal: {len(secrets)} | Evolution Level: {cfg.get('evolution_level',0)}")
PYEOF
}

export_env() {
  ensure_vault
  CONFIG_PATH="$CONFIG_FILE" python3 <<'PYEOF'
import json, os, re, shlex, sys
cfg = os.environ["CONFIG_PATH"]
with open(cfg, encoding="utf-8") as f:
    data = json.load(f)
print("# SecretForge Environment Export")
print("# Source this file: source <(secretforge export)")
for key in data.get('secrets', {}):
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
        print(f"Cannot export invalid environment variable name: {key}", file=sys.stderr)
        sys.exit(1)
    print(f'export {key}="$(secretforge get {shlex.quote(key)})"')
PYEOF
}

show_help() {
  echo "SecretForge CLI v$VERSION"
  echo "Usage: secretforge [--version] [init|set|get|list|export|migrate]"
  echo ""
  echo "Commands:"
  echo "  init              Initialize the vault"
  echo "  set <key> [value] Store a secret (prompts securely if omitted)"
  echo "  get <key>         Retrieve a secret"
  echo "  list              List all secrets"
  echo "  export            Export as shell script"
  echo "  migrate           Add integrity protection to legacy secrets"
  echo "  --version         Show the CLI version"
  echo "  help              Show this help"
}

COMMAND="${1:-help}"
case "$COMMAND" in
  init)
    ensure_vault
    echo "✅ Vault ready at $VAULT_DIR"
    ;;
  set|store)
    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
      echo "Usage: secretforge set <key> [value]" >&2
      exit 2
    fi
    if [ "$#" -eq 3 ]; then
      store_secret "$2" "$3" "manual"
    else
      read_secret_value "$2"
    fi
    echo "✅ Secret stored"
    ;;
  get)
    if [ "$#" -ne 2 ]; then
      echo "Usage: secretforge get <key>" >&2
      exit 2
    fi
    get_secret "$2"
    ;;
  list|ls)
    list_secrets
    ;;
  export)
    export_env
    ;;
  migrate)
    if [ "$#" -ne 1 ]; then
      echo "Usage: secretforge migrate" >&2
      exit 2
    fi
    migrate_vault
    ;;
  help|--help|-h)
    show_help
    ;;
  --version|-V)
    echo "SecretForge CLI v$VERSION"
    ;;
  *)
    echo "❌ Unknown command: $COMMAND" >&2
    echo "Use 'secretforge help' for usage" >&2
    exit 1;
    ;;
esac

log_evolution "Command executed: $COMMAND"